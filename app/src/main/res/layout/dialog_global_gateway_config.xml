<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_lg">

        <!-- Header / Purpose -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_dialog_title"
            android:textAppearance="@style/TextAppearance.Swift.Headline"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_dialog_subtitle"
            android:textAppearance="@style/TextAppearance.Swift.Body"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- 1. Backend URL Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/backendUrlInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:hint="@string/setup_backend_url_label"
            app:helperText="@string/setup_backend_url_helper"
            app:errorEnabled="true"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/backendUrlEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:fontFamily="monospace"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Current Key Display (Masked) -->
        <TextView
            android:id="@+id/currentKeyMaskedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_key_not_configured"
            android:textAppearance="@style/TextAppearance.Swift.Caption"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <!-- 2. Gateway API Key Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/gatewayKeyInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:hint="@string/setup_gateway_key_label"
            app:helperText="@string/setup_gateway_key_helper"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gatewayKeyEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:fontFamily="monospace"
                android:textSize="@dimen/text_size_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Key Actions (Paste / Clear) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="@dimen/spacing_md">

            <Button
                android:id="@+id/btnPasteKey"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_small_height"
                android:text="@string/action_paste_key"
                android:textSize="@dimen/text_size_body_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                style="@style/Widget.Material3.Button.TextButton" />

            <Button
                android:id="@+id/btnClearKeyInDialog"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_small_height"
                android:text="@string/action_clear_key"
                android:textColor="@color/swift_status_error"
                android:textSize="@dimen/text_size_body_sm"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>

        <!-- Connection Test In-Dialog Status Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogTestCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="gone"
            style="@style/Widget.Swift.CardView.HealthTile">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/dialogTestStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Swift.Title"
                    android:textSize="@dimen/text_size_body"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/dialogTestStatusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Swift.Caption" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Security Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_security_notice"
            android:textAppearance="@style/TextAppearance.Swift.Caption"
            android:textColor="@color/swift_text_tertiary" />

    </LinearLayout>

</ScrollView>
