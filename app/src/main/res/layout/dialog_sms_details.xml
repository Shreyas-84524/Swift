<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_dialog_title"
            android:textAppearance="@style/TextAppearance.Swift.Headline"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Recipient Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_phone_label"
            android:textAppearance="@style/TextAppearance.Swift.Caption" />

        <TextView
            android:id="@+id/detailPhoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Swift.Title"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Delivery Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_status_label"
            android:textAppearance="@style/TextAppearance.Swift.Caption" />

        <TextView
            android:id="@+id/detailStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_2xs"
            android:background="@drawable/bg_status_pill"
            android:textAppearance="@style/TextAppearance.Swift.Caption"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Message Body -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_message_label"
            android:textAppearance="@style/TextAppearance.Swift.Caption" />

        <TextView
            android:id="@+id/detailMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Swift.Body"
            android:textColor="@color/swift_text_primary"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Sent Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_timestamp_label"
            android:textAppearance="@style/TextAppearance.Swift.Caption" />

        <TextView
            android:id="@+id/detailTimestampText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Swift.Body"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Global Job ID / Identifiers -->
        <TextView
            android:id="@+id/detailJobIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_job_id_label"
            android:textAppearance="@style/TextAppearance.Swift.Caption" />

        <TextView
            android:id="@+id/detailJobIdText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Swift.Body"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Diagnostics Box (If any) -->
        <TextView
            android:id="@+id/detailDiagnosticsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_section_title"
            android:textAppearance="@style/TextAppearance.Swift.Caption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailDiagnosticsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Swift.Caption"
            android:fontFamily="monospace"
            android:padding="@dimen/spacing_sm"
            android:background="@drawable/bg_status_pill"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_md" />

    </LinearLayout>

</ScrollView>
