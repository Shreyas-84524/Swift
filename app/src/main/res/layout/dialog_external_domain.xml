<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_xl"
    android:paddingVertical="@dimen/spacing_lg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="External Domain Configuration (Legacy)"
        android:textAppearance="@style/TextAppearance.Swift.Headline"
        android:textSize="@dimen/text_size_title"
        android:layout_marginBottom="@dimen/spacing_md" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/enableExternalDomainSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable External Domain Access"
        android:textAppearance="@style/TextAppearance.Swift.Body"
        android:layout_marginBottom="@dimen/spacing_md" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/domainInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="Domain (e.g., sms.yourdomain.com)"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/domainEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/instructionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set up a reverse proxy pointing to this device's local IP and port."
        android:textAppearance="@style/TextAppearance.Swift.Caption"
        android:padding="@dimen/spacing_sm"
        android:background="@drawable/bg_status_pill"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Note: External domain access requires reverse proxy configuration."
        android:textAppearance="@style/TextAppearance.Swift.Caption"
        android:textColor="@color/swift_status_warning" />

</LinearLayout>
