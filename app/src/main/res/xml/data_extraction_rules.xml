<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Security: Exclude sensitive gateway credentials and push tokens from cloud backups -->
        <exclude domain="sharedpref" path="secure_gateway_credentials.xml"/>
        <exclude domain="sharedpref" path="fallback_gateway_credentials.xml"/>
        <exclude domain="sharedpref" path="fcm_token_cache.xml"/>
        <exclude domain="sharedpref" path="sms_gateway_config.xml"/>
        <exclude domain="database" path="sms_database"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_gateway_credentials.xml"/>
        <exclude domain="sharedpref" path="fallback_gateway_credentials.xml"/>
        <exclude domain="sharedpref" path="fcm_token_cache.xml"/>
    </device-transfer>
</data-extraction-rules>
