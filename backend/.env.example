# Swift uses Supabase Auth exclusively for the owner console.
DATABASE_URL=postgresql://user:password@host:port/database
# Existing project provisioning CLI credential (not a console login)
ADMIN_SECRET_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SWIFT_OWNER_USER_ID=
SWIFT_OWNER_EMAIL=
SWIFT_OWNER_NAME=Swift Owner
# Provisioning only: supply SUPABASE_SECRET_KEY and SWIFT_OWNER_PASSWORD
# transiently in the shell when running npm run owner:configure.
# Never deploy a service-role/secret key or plaintext owner password.
DEFAULT_OTP_EXPIRY_SECONDS=300
DEFAULT_OTP_COOLDOWN_SECONDS=30
DEFAULT_MAX_VERIFY_ATTEMPTS=3
DEFAULT_HOURLY_SEND_LIMIT=5
