# Swift uses Supabase Auth exclusively for the owner console.
DATABASE_URL=postgresql://user:password@host:port/database
# Existing project provisioning CLI credential (not a console login)
ADMIN_SECRET_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SWIFT_OWNER_USER_ID=
SWIFT_OWNER_EMAIL=
SWIFT_OWNER_NAME=Swift Owner
# Provisioning only: supply SUPABASE_SECRET_KEY and SWIFT_OWNER_PASSWORD
# transiently in the shell when running npm run owner:configure.
# Never deploy a service-role/secret key or plaintext owner password.
DEFAULT_OTP_EXPIRY_SECONDS=300
DEFAULT_OTP_COOLDOWN_SECONDS=30
DEFAULT_MAX_VERIFY_ATTEMPTS=3
DEFAULT_HOURLY_SEND_LIMIT=5

# Firebase Cloud Messaging (FCM) Server Configuration (Phase 2 Push Wake)
# Server-only credentials used exclusively for FCM HTTP v1 device wake signals.
# Never expose these with NEXT_PUBLIC_ or commit a service-account JSON file.
# In private key, newline escapes (\n) are automatically converted at runtime.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Phase 4 internal outbox dispatcher. Generate at least 32 random bytes and
# provide it only to the trusted scheduler through an Authorization header.
OUTBOX_SCHEDULER_SECRET=
